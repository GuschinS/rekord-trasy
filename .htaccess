# Rekord Trasy — konfiguracja Apache. Zachowuje stare adresy (Joomla) po migracji.
RewriteEngine On

# Jedna wersja adresu: https + www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.rekord-trasy.info%{REQUEST_URI} [R=301,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Stare adresy Joomla -> nowe odpowiedniki
RedirectMatch 301 ^/pl\.html$ /
RedirectMatch 301 ^/pl/?$ /
RedirectMatch 301 ^/pl[0-9a-f]{4}\.html$ /
RedirectMatch 301 ^/pl/(rekordzisci|historia|regulamin|media|linki|kontakt)[0-9a-f]{4}\.html$ /pl/$1.html
RedirectMatch 301 ^/pl/component/content/article/.*$ /pl/historia.html
RedirectMatch 301 ^/pl/component/.*$ /
# Wersje językowe są częścią nowej wersji strony (/nowa/)
RewriteCond %{THE_REQUEST} \s/en\.html[\s?] [NC]
RewriteRule ^en\.html$ /nowa/en/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/(en|de)(/[^\s?]*)?[\s?] [NC]
RewriteRule ^(en|de)(/.*)?$ /nowa/$1/ [R=301,L]

# Dawne strony RODO i plików cookie -> polityka prywatności
RedirectMatch 301 ^/(rodo|cookies)\.html$ /pl/polityka-prywatnosci.html

# Stare adresy zdjęć (wyszukiwarka grafiki)
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/gemini_3_20100604_1033808150\.jpg$ /assets/img/gemini-3.jpg
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/insgraf_20100604_1447126469\.jpg$ /assets/img/insgraf.jpg
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/almatur_iii_20100604_1972321041\.jpg$ /assets/img/almatur-iii.jpg
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/cooler_i_alka_prim_20100604_1054221199\.png$ /assets/img/cooler-i-alka-prim.png
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/hadar_20100604_1532699527\.png$ /assets/img/hadar.png
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/komandor_ii_20100604_2042161531\.jpg$ /assets/img/komandor-ii.jpg
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/hetman_20100604_1878202658\.jpg$ /assets/img/hetman.jpg
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/roman_paszke_20100603_1748033269\.jpg$ /assets/img/roman-paszke.jpg
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/puchar_20100604_1619414144\.png$ /assets/img/puchar.png
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/strona_tytuowa_20100603_1054689775\.png$ /assets/img/strona-tytulowa.png
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/angielski_regulamin_rekordu_20100604_1688657573\.jpg$ /assets/img/angielski-regulamin-rekordu.jpg
RedirectMatch 301 ^/components/com_joomgallery/img_(?:originals|pictures|thumbnails)/rekord_trasy_1/odpowied_od_world_sailing_speed_record_20100604_1755106031\.jpg$ /assets/img/odpowiedz-wssr.jpg
RedirectMatch 301 ^/templates/joomlabluepulse/images/Logo\.png$ /assets/img/logo.png

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 10 minutes"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
